<script>// Brief 15 B2B planning layer. USD reporting, explicit nominal naira/FX paths.
function b2bPlan(Q, E, opt={}) {
 const A={crews:6000,annualBudget:0,ruralExtra:0,backboneExtra:0,b2bMonthly:E.discoContrib/Q.fx,incrementalUtilityCost:null,waiveLow:true,indexReceipts:false,stressInflation:10,...opt};
 const C0=Q.customers*1e6,initial=C0*Q.metered/100,backlog=C0-initial, profile=[Q.y1,Q.y2,Q.y3,Q.y4,Q.y5],sum=profile.reduce((a,b)=>a+b,0),capacity=A.crews*Q.perDay*Q.days;
 let init=initial,prog=0,pop=C0,carry=0,failedInit=0,failedProg=0,requiredCrew=0,carryRural=0;
 const rows=[],lowWaiver=E.T[0].share*E.T[0].collected/Q.fx;
 const custBase=Math.max(0,E.custCollected/Q.fx-(A.waiveLow?lowWaiver:0));
 const feeCapex=unitCost(Q,1,false).total/Q.fx;
 const hw=Q.hwUsd+Q.smartShare/100*Q.smartPremium,foreign=hw*(1+(Q.local*Q.kitDuty+(100-Q.local)*Q.duty)/10000)*(1+Q.vat/100),local=Math.max(0,feeCapex-foreign);
 const om=(Q.omStd*(1-Q.smartShare/100)+Q.omSmart*Q.smartShare/100)/Q.fx; // actual replacement capex below, no duplicate failure reserve
 const ruralTotal=backlog*Q.solar/100,networkTotal=(backlog-ruralTotal)*Math.max(0,100-Q.greenShare-Q.amberShare)/100*Q.upgradeShare/100/Q.custPerDT*Q.dtCost/Q.fx;
 let neededProg=0,neededInitial=initial;
 for(let t=1;t<=5;t++){
  const weight=profile[t-1]/sum, growth=pop*Q.growth/100;pop+=growth;
  const blocked=(backlog-backlog*Q.solar/100)*Math.max(0,100-Q.greenShare-Q.amberShare)/100*(1-Q.upgradeShare/100);
  const desired=(backlog-blocked)*weight+growth, rural=backlog*weight*Q.solar/100;
  const rate=(t<=Q.warranty?Q.failWar:Q.failAfter)/100+Q.vandal/100;
  const idealRepl=(neededProg+neededInitial)*rate,idealLegacy=Math.min(neededInitial*(1-rate),initial*Q.legacyShare/100/5);
  requiredCrew=Math.max(requiredCrew,Math.ceil((desired+idealRepl+idealLegacy)/(Q.perDay*Q.days)));
  neededInitial=Math.max(0,neededInitial-idealLegacy-neededInitial*rate);neededProg+=desired+idealLegacy+idealRepl-neededProg*rate;
  const progStart=prog;failedInit+=init*rate;failedProg+=prog*rate;init*=1-rate;prog*=1-rate;
  let free=capacity;
  const repairProg=Math.min(failedProg,free);free-=repairProg;failedProg-=repairProg;prog+=repairProg;
  const repairInit=Math.min(failedInit,free);free-=repairInit;failedInit-=repairInit;prog+=repairInit;
  const legacy=Math.min(init,initial*Q.legacyShare/100/5,free);free-=legacy;init-=legacy;prog+=legacy;
  const due=desired+carry,newCount=Math.min(due,free),ruralNew=(rural+carryRural)*(due?newCount/due:0);carryRural=rural+carryRural-ruralNew;carry=due-newCount;prog+=newCount;
  const on=SCC(Q,t),infl=(1+Q.inflation/100)**(t-1)*(on?((1+(Q.inflation+A.stressInflation)/100)/(1+Q.inflation/100))**(t-Q.shockYear+1):1),fxFactor=((1+Q.inflation/100)*(1+Q.fxDep/100))**(t-1)*(on?1+Q.fxShock/100:1);
  const localFactor=infl/fxFactor*(1+(Q.realEsc||0)/100)**(t-1),feeFactor=(A.indexReceipts?infl:1)/fxFactor;
