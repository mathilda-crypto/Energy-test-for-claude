<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Every Home Metered — B2B Brief 15 model</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@600;700&family=Chivo+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --top:#1F2A44; --top2:#171F33; --top-ink:#FFFFFF; --top-muted:#B9C6DA;
  --canvas:#F4F4F2; --surface:#FFFFFF; --ink:#181818; --muted:#5C5C5C; --line:#DDDBDA;
  --accent:#1F4E79; --accent-soft:#EEF3F8;
  --note-bg:#FFFBEA; --note-line:#B88A00;
  --good:#2E844A; --good-soft:#E6F4EA; --warn:#A96404; --warn-soft:#FEF1DC; --bad:#BA0517; --bad-soft:#FDE7E9;
  --bar:#1F4E79; --bar2:#A9BFD6;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --top:#0B1A33; --top2:#081428; --top-ink:#F1F4F8; --top-muted:#97A6BD;
    --canvas:#101418; --surface:#1A2027; --ink:#ECEDEE; --muted:#A7ADB4; --line:#303841;
    --accent:#8DB3DA; --accent-soft:#1A2633;
    --note-bg:#29240F; --note-line:#D9B23C;
    --good:#5CC27E; --good-soft:#18301F; --warn:#E3A84B; --warn-soft:#352812; --bad:#F07C86; --bad-soft:#3A1A1D;
    --bar:#8DB3DA; --bar2:#34506E; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --top:#0B1A33; --top2:#081428; --top-ink:#F1F4F8; --top-muted:#97A6BD;
  --canvas:#101418; --surface:#1A2027; --ink:#ECEDEE; --muted:#A7ADB4; --line:#303841;
  --accent:#8DB3DA; --accent-soft:#1A2633;
  --note-bg:#29240F; --note-line:#D9B23C;
  --good:#5CC27E; --good-soft:#18301F; --warn:#E3A84B; --warn-soft:#352812; --bad:#F07C86; --bad-soft:#3A1A1D;
  --bar:#8DB3DA; --bar2:#34506E; color-scheme:dark;
}
/* Actor colours (line colour around each box) */
.a-customer{--ac:#EA580C}.a-disco{--ac:#DC2626}.a-gov{--ac:#2563EB}.a-reg{--ac:#4F46E5}.a-bank{--ac:#059669}
.a-op{--ac:#0D9488}.a-map{--ac:#7C3AED}.a-local{--ac:#DB2777}.a-agent{--ac:#A16207}.a-inv{--ac:#0891B2}
.a-nemsa{--ac:#65A30D}.a-supp{--ac:#64748B}.a-all{--ac:#94A3B8}
*,*::before,*::after{box-sizing:border-box}
html,body{height:100%}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--canvas);color:var(--ink);font-family:"Source Sans 3",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:1.45}
h1,h2,h3{margin:0;line-height:1.2}
button,select,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.num,.mono{font-family:"Source Sans 3",system-ui,sans-serif}

/* Top bar */
.topbar{background:var(--top);color:var(--top-ink);display:flex;align-items:center;gap:14px;padding:10px 16px;position:sticky;top:0;z-index:20}
.topbar .logo{width:26px;height:26px;border-radius:5px;background:#fff;display:grid;place-items:center;flex:none}
.topbar .logo span{width:14px;height:14px;border:2px solid var(--top);border-radius:2px;display:block}
.topbar h1{font-size:1.05rem;font-weight:600;white-space:nowrap}
.tabs{display:flex;gap:2px;margin-left:12px;overflow-x:auto}
.tab{background:transparent;border:0;color:var(--top-muted);padding:7px 12px;border-radius:6px;cursor:pointer;white-space:nowrap;font-weight:600}
.tab[aria-selected="true"]{background:rgba(255,255,255,.14);color:var(--top-ink)}
.tab:hover{color:var(--top-ink)}
.toolbar{background:var(--surface);border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:8px 16px;position:sticky;top:46px;z-index:19}
.toolbar label{font-size:.85rem;color:var(--muted);display:flex;align-items:center;gap:6px}
.sel,.tbtn{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:5px 10px;font-weight:600;cursor:pointer}
.tbtn.primary{color:var(--accent)}
.toolbar .spacer{flex:1}
.drawer-btn{display:none}
.toast{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--ink);color:var(--surface);padding:8px 14px;border-radius:8px;font-size:.9rem;opacity:0;pointer-events:none;transition:opacity .2s;z-index:50}
.toast.on{opacity:1}

/* Layout */
.shell{display:grid;grid-template-columns:280px 1fr;min-height:calc(100vh - 100px)}
.side{background:var(--surface);border-right:1px solid var(--line);padding:14px 14px 40px;position:sticky;top:94px;height:calc(100vh - 94px);overflow-y:auto}
.side h2{font-size:.95rem;margin:4px 0 8px}
.side .hint{font-size:.82rem;color:var(--muted);margin:0 0 10px}
.search{display:flex;align-items:center;border:1px solid var(--line);border-radius:6px;padding:4px 8px;margin-bottom:12px;background:var(--canvas)}
.search input{border:0;background:transparent;width:100%;padding:3px 2px;outline:none}
.lever{margin:10px 0 14px}
.lever .top{display:flex;justify-content:space-between;gap:8px;font-size:.88rem}
.lever .top b{font-family:"Source Sans 3",system-ui,sans-serif;font-weight:700;white-space:nowrap}
.lever input[type=range]{width:100%;accent-color:var(--accent)}
.lever .aff{font-size:.75rem;color:var(--muted)}
.toggle{display:flex;align-items:center;gap:8px;font-size:.88rem;margin:6px 0 12px}
.toggle input{width:17px;height:17px;accent-color:var(--accent)}
details.grp{border-top:1px solid var(--line);padding:6px 0}
details.grp>summary{cursor:pointer;font-weight:700;list-style:none;display:flex;gap:8px;align-items:center;padding:4px 0}
details.grp>summary::before{content:"▸";color:var(--muted);transition:transform .15s}
details.grp[open]>summary::before{transform:rotate(90deg)}
.complist{list-style:none;margin:2px 0 6px;padding:0}
.complist button{width:100%;text-align:left;background:transparent;border:0;padding:5px 6px;border-radius:5px;display:flex;align-items:center;gap:8px;cursor:pointer;font-size:.9rem}
.complist button:hover{background:var(--accent-soft)}
.complist .ico{width:16px;height:16px;border-radius:4px;border:2px solid var(--ac);flex:none}
main{padding:16px;min-width:0}
.view{display:none}
.view.on{display:block}

/* Cards */
.canvas{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:14px;align-items:start}
.card{background:var(--surface);border:2px solid var(--ac);border-radius:8px;padding:0;min-width:0;scroll-margin-top:110px}
.card.span2{grid-column:span 2}
.card.span3{grid-column:1/-1}
.card.sel{box-shadow:0 0 0 3px var(--accent)}
.card>header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line)}
.card>header h3{font-size:1rem;font-weight:700}
.owner{display:inline-flex;align-items:center;gap:6px;font-size:.76rem;font-weight:600;border:1px solid var(--line);border-radius:999px;padding:1px 8px;white-space:nowrap;background:var(--surface)}
.owner::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--ac)}
.card .body{padding:12px 14px}
.card .lead{color:var(--muted);font-size:.88rem;margin:0 0 8px}
details.more{margin-top:10px;border-top:1px dashed var(--line);padding-top:6px}
details.more>summary{cursor:pointer;color:var(--accent);font-weight:600;font-size:.88rem;list-style:none}
details.more>summary::after{content:" ▾"}
.notes{margin:0 14px 14px;border:1.5px dashed var(--note-line);background:var(--note-bg);border-radius:6px;padding:8px 10px}
.notes label{display:block;font-size:.8rem;font-weight:700;color:var(--ink);margin-bottom:4px}
.notes textarea{width:100%;min-height:52px;border:0;background:transparent;resize:vertical;font-size:.9rem;outline:none}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:8px 0}
.kpi{border-left:3px solid var(--accent);padding:2px 0 2px 10px}
.kpi .v{font-family:"Source Sans 3",system-ui,sans-serif;font-size:1.2rem;font-weight:700}
.kpi .l{font-size:.8rem;color:var(--muted)}
.kpi.warn{border-color:var(--warn)}.kpi.bad{border-color:var(--bad)}.kpi.good{border-color:var(--good)}
.verdict{font-size:1.12rem;font-weight:600;margin:2px 0 10px;max-width:80ch}
.flag{border-radius:6px;padding:8px 10px;margin-top:8px;font-size:.88rem}
.flag.ok{background:var(--good-soft)}.flag.warn{background:var(--warn-soft)}.flag.bad{background:var(--bad-soft)}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.86rem}
th,td{padding:6px 7px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}
th:first-child,td:first-child{text-align:left}
th{font-weight:600;color:var(--muted);font-size:.78rem;white-space:nowrap}
td.n{font-family:"Source Sans 3",system-ui,sans-serif;font-size:.8rem;white-space:nowrap}
table.txt td,table.txt th{text-align:left}
tr.hl td{background:var(--accent-soft)}
.line{display:flex;justify-content:space-between;gap:10px;padding:3px 0;border-bottom:1px dashed var(--line);font-size:.88rem}
.line:last-child{border-bottom:0}
.line b{font-family:"Source Sans 3",system-ui,sans-serif;font-weight:700;white-space:nowrap}
.chart{width:100%;display:block}
.chart text{font-family:"Source Sans 3",system-ui,sans-serif;font-size:11px;fill:var(--muted)}
.chart text.lab{font-family:"Source Sans 3",system-ui,sans-serif;font-size:12px;fill:var(--ink)}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.8rem;margin-top:6px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:11px;height:11px;border-radius:2px;display:inline-block}
.flowrow{display:flex;flex-wrap:wrap;align-items:stretch;gap:6px}
.node{flex:1 1 120px;border:2px solid var(--ac);border-radius:6px;padding:7px 8px;font-size:.82rem;background:var(--surface)}
.node b{display:block;font-size:.86rem}
.arrow{align-self:center;color:var(--muted);font-weight:700}
ol.order{margin:8px 0 0;padding-left:20px;font-size:.86rem}
ol.order li{margin:2px 0}
.steps{display:flex;flex-direction:column;gap:6px}
.stepr{display:grid;grid-template-columns:28px 1fr;gap:8px;border-left:4px solid var(--ac);background:var(--canvas);border-radius:4px;padding:7px 8px;font-size:.84rem}
.stepr .no{font-family:"Source Sans 3",system-ui,sans-serif;font-weight:700;color:var(--muted)}
.stepr h4{margin:0 0 2px;font-size:.9rem}
.stepr .k{color:var(--muted)}
ul.plain{margin:4px 0 0;padding-left:18px;font-size:.88rem}
ul.plain li{margin:2px 0}
.chips{display:flex;flex-wrap:wrap;gap:4px}

/* Data sheet */
.sheet-tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:0 0 10px}
.sheet{background:var(--surface);border:1px solid var(--line);border-radius:8px;overflow:auto;max-height:calc(100vh - 210px)}
.sheet table{min-width:980px}
.sheet thead th{position:sticky;top:0;background:var(--surface);z-index:1}
.sheet tr.grp td{background:var(--canvas);font-weight:700;text-align:left}
.sheet input.val{width:110px;text-align:right;border:1.5px solid var(--accent);border-radius:5px;padding:3px 6px;background:var(--accent-soft);font-family:"Source Sans 3",system-ui,sans-serif;font-size:.82rem}
.sheet input.src{width:100%;min-width:220px;border:1.5px dashed var(--note-line);background:var(--note-bg);border-radius:5px;padding:3px 6px;font-size:.84rem}
.sheet select{border:1px solid var(--line);border-radius:5px;padding:2px 4px;background:var(--surface)}
.sheet td{vertical-align:middle}
.tag{border-radius:4px;padding:0 6px;font-weight:600;font-size:.76rem;white-space:nowrap}
.t-src{background:var(--good-soft);color:var(--good)}.t-proxy{background:var(--accent-soft);color:var(--accent)}
.t-design{background:var(--canvas);color:var(--muted)}.t-guess{background:var(--warn-soft);color:var(--warn)}
.inf{font-weight:700;font-size:.78rem}.inf.H{color:var(--bad)}.inf.M{color:var(--warn)}.inf.L{color:var(--muted)}
.changed td:first-child::after{content:" •";color:var(--accent);font-weight:700}

/* Who's who */
.actor .body p{margin:4px 0;font-size:.88rem}
.actor input.name{width:100%;border:1.5px solid var(--accent);background:var(--accent-soft);border-radius:5px;padding:4px 7px;margin:4px 0 6px}
.swatch{display:inline-block;width:40px;height:14px;border:3px solid var(--ac);border-radius:4px;vertical-align:middle;margin-right:6px}

/* Risk */
.heat{display:grid;grid-template-columns:96px repeat(3,minmax(0,1fr));gap:6px;font-size:.84rem}
.heat .ax{color:var(--muted);display:flex;align-items:center;justify-content:center;text-align:center;font-size:.78rem}
.heat .cell{border-radius:6px;padding:6px;min-height:52px;display:flex;flex-wrap:wrap;gap:4px;align-content:flex-start}
.c1{background:var(--good-soft)}.c2{background:var(--warn-soft)}.c3{background:var(--bad-soft)}
.rchip{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:0 7px;font-family:"Source Sans 3",system-ui,sans-serif;font-size:.75rem}

/* Ideas */
.addidea{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.addidea input{flex:1 1 260px;border:1.5px dashed var(--note-line);background:var(--note-bg);border-radius:6px;padding:7px 9px}
.idea select{border:1px solid var(--line);border-radius:5px;padding:2px 4px;background:var(--surface)}
.idea textarea{width:100%;min-height:46px;border:1.5px dashed var(--note-line);background:var(--note-bg);border-radius:6px;padding:6px 8px;resize:vertical;font-size:.88rem}
.st{font-size:.75rem;font-weight:700;border-radius:4px;padding:1px 6px}
.st-parked{background:var(--canvas);color:var(--muted)}.st-exploring{background:var(--warn-soft);color:var(--warn)}.st-pitch{background:var(--good-soft);color:var(--good)}
.help .body h4{margin:10px 0 4px}
.help .body p,.help .body li{font-size:.92rem}

/* Business model canvas */
.bmc{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.bmc2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.blk{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:12px 14px;min-width:0}
.blk h3{display:flex;align-items:center;gap:10px;color:var(--accent);font-size:1rem}
.blk .ic{width:34px;height:34px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700;flex:none;font-family:"Source Sans 3",system-ui,sans-serif}
.blk ul{padding-left:18px;margin:8px 0 0;font-size:.86rem}
.blk li{margin:3px 0}
.b-kp{grid-column:1;grid-row:1/3}.b-ka{grid-column:2;grid-row:1}.b-kr{grid-column:2;grid-row:2}.b-vp{grid-column:3;grid-row:1/3}.b-cr{grid-column:4;grid-row:1}.b-ch{grid-column:4;grid-row:2}.b-cs{grid-column:5;grid-row:1/3}
.add{font-size:.68rem;font-weight:700;background:var(--good-soft);color:var(--good);border-radius:4px;padding:0 5px;margin-left:4px;white-space:nowrap}
/* Strategy roadmap */
.gyears{display:grid;grid-template-columns:repeat(5,1fr);font-size:.78rem;color:var(--muted);margin-bottom:6px;border-bottom:1px solid var(--line);padding-bottom:4px}
.gantt{display:grid;grid-template-columns:repeat(60,minmax(0,1fr));gap:6px 0}
.gbar{border:2px solid var(--ac);background:var(--accent-soft);border-radius:5px;padding:4px 8px;font-weight:700;font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gcov{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:10px}
.gcov div{text-align:center;background:var(--good-soft);border-radius:5px;padding:4px;font-family:"Source Sans 3",system-ui,sans-serif;font-weight:700;font-size:.85rem}
.phase h4{margin:8px 0 2px;font-size:.88rem}
@media (max-width:1100px){.bmc{grid-template-columns:1fr 1fr}.bmc .blk{grid-column:auto!important;grid-row:auto!important}.bmc2{grid-template-columns:1fr}}
@media (max-width:1100px){.card.span2{grid-column:auto}}
@media (max-width:900px){
  .shell{grid-template-columns:1fr}
  .side{position:fixed;left:0;top:0;bottom:0;width:min(86vw,320px);height:auto;z-index:40;transform:translateX(-105%);transition:transform .2s;box-shadow:0 0 30px rgba(0,0,0,.25);padding-top:calc(14px + env(safe-area-inset-top,0px))}
  .side.open{transform:none}
  .drawer-btn{display:inline-block}
  .canvas{grid-template-columns:1fr}
  .toolbar{top:46px}
}
/* Formal document styling */
h1,h2,h3,.verdict,.blk h3{font-family:"Source Serif 4",Georgia,"Times New Roman",serif}
.kpi .v,td.n,.line b,.lever .top b,.gcov div{font-variant-numeric:tabular-nums}
.card,.blk,.node,.sheet,.notes,.search,.sel,.tbtn,.stepr{border-radius:3px}
.card{border-width:1.5px}
.card>header{background:var(--canvas)}
.owner{border-radius:2px;background:transparent}
.owner::before{border-radius:1px}
.tab{border-radius:0}
.tab[aria-selected="true"]{background:transparent;box-shadow:inset 0 -3px 0 var(--top-ink)}
.kpi{border-left-width:2px}
.kpi .v{font-size:1.15rem;font-weight:600}
.verdict{font-size:1.05rem;font-weight:600}
.notes{border:1px solid var(--note-line);border-left-width:3px;background:var(--note-bg)}
.notes label{font-weight:600;font-size:.78rem;text-transform:none;color:var(--muted)}
.blk .ic{border-radius:2px;font-family:"Source Serif 4",Georgia,serif}
.add{border-radius:2px}
.topbar .logo{border-radius:2px}
.site-foot{margin:28px 0 8px;padding-top:10px;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted)}
tr.hl-row td{background:var(--accent-soft)!important}
tr.gap td{background:var(--warn-soft)}
tr.gap2 td{background:var(--bad-soft)}
.bm-flow{display:grid;grid-template-columns:1fr 32px 1fr 32px 1fr;align-items:stretch;margin-top:14px}
.bm-arrow{display:flex;align-items:center;justify-content:center;font-size:1.6rem;color:var(--muted)}
.bm-col{height:100%}
.bm-n{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:2px;background:var(--accent);color:#fff;font-size:.8rem;margin-right:8px;font-family:"Source Sans 3",sans-serif;vertical-align:1px}
.bm-seg{display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:.88rem}
.bm-seg span{font-size:.76rem;color:var(--muted);white-space:nowrap}
.bm-seg.muted b{color:var(--muted);font-weight:600}
.bm-check{list-style:none;padding:0;margin:0;font-size:.88rem}
.bm-check li{padding:5px 0 5px 22px;position:relative;border-bottom:1px dashed var(--line)}
.bm-check li::before{content:"";position:absolute;left:2px;top:9px;width:10px;height:6px;border-left:2px solid var(--good);border-bottom:2px solid var(--good);transform:rotate(-45deg)}
.chev{display:flex;flex-wrap:wrap;gap:4px}
.chev span{background:var(--accent-soft);color:var(--ink);padding:9px 18px 9px 22px;font-size:.84rem;font-weight:600;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 50%,calc(100% - 12px) 100%,0 100%,12px 50%)}
.chev span:first-child{clip-path:polygon(0 0,calc(100% - 12px) 0,100% 50%,calc(100% - 12px) 100%,0 100%);padding-left:14px}
.bm-engine{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:14px;margin-top:14px}
@media (max-width:900px){.bm-flow{grid-template-columns:1fr}.bm-arrow{transform:rotate(90deg);height:28px}.bm-engine{grid-template-columns:1fr}}
.tbtn[aria-pressed="true"]{background:var(--accent);color:#fff;border-color:var(--accent)}

/* Preserve Claude palette, stakeholder colours and fonts; simplify the workspace. */
