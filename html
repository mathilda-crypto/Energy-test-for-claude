function unitCost(Q,year,shock){
  const on=shock&&year>=Q.shockYear, keep=1-Q.supplierBand/100;
  const fx=Q.fx*Math.pow(1+Q.fxDep/100,year-1)*(on?1+Q.fxShock/100*keep:1);
  const dutyImp=Q.duty+(on?Q.dutyShock*keep:0);
  const dutyEff=(Q.local/100)*Q.kitDuty+(1-Q.local/100)*dutyImp;
  const usd=Q.hwUsd+(Q.smartShare/100)*Q.smartPremium;
  const hw=usd*fx, duty=hw*dutyEff/100, vat=(hw+duty)*Q.vat/100, inst=Q.install*Math.pow(1+(Q.realEsc||0)/100,year-1);
  const prem=(Q.amberShare/100)*Q.premisesCost, dtm=Q.custPerDT>0?Q.dtMeter/Q.custPerDT:0;
  const meterOnly=hw+duty+vat+inst;
  return {fx,usd,hw,duty,vat,dutyEff,inst,it:Q.it,agent:Q.agent,prem,dtm,meterOnly,total:meterOnly+Q.it+Q.agent+prem+dtm};
}
function rollout(Q,shock){
  const C0=Q.customers*1e6, m0=Q.metered/100, g=Q.growth/100;
  const backlog=C0*(1-m0), solarHH=backlog*Q.solar/100, gridBacklog=backlog-solarHH;
  const readyPct=Math.min(100,Q.greenShare+Q.amberShare)/100, redBacklog=gridBacklog*(1-readyPct);
  const redMeterable=redBacklog*Q.upgradeShare/100, unmeterable=redBacklog-redMeterable;
  const plan=gridBacklog*readyPct+redMeterable;
  const prof=[Q.y1,Q.y2,Q.y3,Q.y4,Q.y5], ps=prof.reduce((a,b)=>a+b,0)||1;
  const cap=Q.crews*Q.perDay*Q.days;
  const legacyTot=C0*m0*Q.legacyShare/100, legacyYr=legacyTot/5;
  const replRate=(Q.warranty>=5?Q.failWar:(Q.failWar*Q.warranty+Q.failAfter*(5-Q.warranty))/5)+Q.vandal;
  let metered=C0*m0, prevC=C0, carry=0, fleet=0, capexNew=0, legacyCost=0; const years=[];
  for(let t=1;t<=5;t++){
    const Ct=C0*Math.pow(1+g,t), newConn=prevC*g;
    const target=plan*prof[t-1]/ps+newConn+carry, repl=fleet*replRate/100;
    const newInst=Math.min(target,Math.max(0,cap-repl-legacyYr)); carry=target-newInst;
    const sol=solarHH*prof[t-1]/ps, u=unitCost(Q,t,shock), capex=newInst*u.total;
    capexNew+=capex; legacyCost+=legacyYr*u.meterOnly; metered+=newInst+sol; fleet+=newInst;
    years.push({t,Ct,newInst,repl,legacy:legacyYr,sol,carry,capex,share:Math.min(metered/Ct,1),left:Math.max(Ct-metered,0),load:(newInst+repl+legacyYr)/cap});
    prevC=Ct;
  }
  const capexTot=years.reduce((a,y)=>a+y.capex,0);
  const dtUpgrade=Q.custPerDT>0?redMeterable/Q.custPerDT:0, dtFleet=Q.custPerDT>0?fleet/Q.custPerDT:0;
  const u1=unitCost(Q,1,shock);
  return {C0,backlog,solarHH,gridBacklog,redBacklog,redMeterable,unmeterable,cap,years,fleet,capexTot,avgUnit:fleet>0?capexNew/fleet:0,
    legacyTot,legacyCost,dtUpgrade,networkCost:dtUpgrade*Q.dtCost,dtVandalYr:dtFleet*Q.dtVandal/100,dtVandalCost:dtFleet*Q.dtVandal/100*Q.dtCost,
    replFull:u1.meterOnly,replInst:u1.inst,u1};
}
function econ(Q,R,shock){
  const hs=Math.max(0,100-Q.lowShare-Q.midShare)/100, sh=shock?Q.topupShock:0;
  const T=[{name:"Low",share:Q.lowShare/100,spend:Q.lowSpend,col:Q.colLow/100,dorm:Math.min(1,(Q.dormLow+sh)/100)},
           {name:"Mid",share:Q.midShare/100,spend:Q.midSpend,col:Q.colMid/100,dorm:Math.min(1,(Q.dormMid+sh)/100)},
           {name:"High",share:hs,spend:Q.highSpend,col:Q.colHigh/100,dorm:Math.min(1,(Q.dormHigh+sh)/100)}];
  const ob=Q.overbill/100;
  T.forEach(t=>{t.use=t.spend*(1-ob); t.before=t.spend*t.col; t.after=t.use*(1-t.dorm); t.uplift=t.after-t.before;});
  const ws=f=>T.reduce((a,t)=>a+t.share*f(t),0);
  const upliftAvg=ws(t=>t.uplift), discoGain=Math.max(0,upliftAvg)*Q.discoShare/100, resultsPay=Q.lossRecov*Q.resultsShare/100;
  const discoContrib=discoGain+resultsPay;
  const rc=(Q.dfiPart*Q.dfiRate+(100-Q.dfiPart)*Q.bondRate)/10000, r=rc/12, n=Q.term*12, lag=Q.lag;
  const omBase=(1-Q.smartShare/100)*Q.omStd+(Q.smartShare/100)*Q.omSmart;
  const w=Math.min(Q.warranty,Q.term), after=Math.max(0,Q.term-w);
  const inWarYr=(Q.failWar/100)*R.replInst+(Q.vandal/100)*R.replFull, afterYr=((Q.failAfter+Q.vandal)/100)*R.replFull;
  const reserve=Q.term>0?(w*inWarYr+after*afterYr)/(Q.term*12):0, omEff=omBase+reserve;
  const unit=R.avgUnit;
  const neededTotal=annuity(unit*Math.pow(1+r,lag),r,n)+omEff, custNeeded=Math.max(0,neededTotal-discoContrib);
  const cap=Q.feeCap/100, pctMode=Q.pctMode>=0.5;
  const activeBase=ws(t=>t.use*(1-t.dorm)), activeShare=ws(t=>1-t.dorm);
  const neededPct=activeBase>0?custNeeded/activeBase:0, chargedPct=Math.min(cap,neededPct), flatNeeded=activeShare>0?custNeeded/activeShare:0;
  T.forEach(t=>{t.fee=pctMode?chargedPct*t.use:Math.min(flatNeeded,cap*t.use); t.feeShare=t.use>0?t.fee/t.use:0; t.collected=t.fee*(1-t.dorm);});
  const custCollected=ws(t=>t.collected), inflow=custCollected+discoContrib, net=inflow-omEff;
  const cover=Math.max(1,Q.dscr||1), pvCap=net>0?pvAnn(net/cover,r,n)/Math.pow(1+r,lag):0, commercialPerMeter=Math.min(unit,pvCap);
  const publicPerMeter=unit-commercialPerMeter, publicShare=unit>0?publicPerMeter/unit:0;
  const payPerMeter=commercialPerMeter>0?annuity(commercialPerMeter*Math.pow(1+r,lag),r,n):0;
  const paybackMonths=net>0?lag+(unit+omEff*lag)/net:Infinity;
  const fr=x=>inflow>0?x/inflow:0;
  const split={customer:commercialPerMeter*fr(custCollected),disco:commercialPerMeter*fr(discoGain),results:commercialPerMeter*fr(resultsPay),public:publicPerMeter};
  const upkeepGap=Math.max(0,-net);
  return {T,upliftAvg,discoGain,resultsPay,discoContrib,rc,r,n,lag,omBase,reserve,omEff,unit,neededTotal,custNeeded,neededPct,chargedPct,pctMode,
    custCollected,inflow,net,commercialPerMeter,publicPerMeter,publicShare,payPerMeter,paybackMonths,split,upkeepGap,
    publicTot:R.capexTot*publicShare,commercialTot:R.capexTot*(1-publicShare),upkeepGapTot:upkeepGap*12*R.fleet};
}
function cashflow(R,E){const rows=[]; let cum=0,payYear=null;
  for(let y=1;y<=15;y++){const ys=(y-1)*12,ye=y*12; let revM=0,omM=0;
    R.years.forEach(c=>{const inst=(c.t-1)*12+6, rs=inst+E.lag, re=rs+E.n; revM+=c.newInst*overlap(ys,ye,rs,re); omM+=c.newInst*overlap(ys,ye,inst,re);});
    const capex=y<=5?R.years[y-1].capex:0, fees=revM*E.custCollected, disco=revM*E.discoContrib, om=omM*E.omEff;
    const debt=revM*Math.min(E.payPerMeter,Math.max(0,E.net)), net=fees+disco-om-capex; cum+=net;
    if(payYear===null&&cum>=0&&y>5) payYear=y;
    rows.push({y,active:revM/12,capex,pub:capex*E.publicShare,fees,disco,om,debt,net,cum});}
  return {rows,payYear};}
function bizCase(M){const {Q,R,E,CF}=M, capex=R.capexTot, cont=capex*Q.contingency/100, runc=capex*Q.runCost/100;
  const upkeepGap=E.upkeepGapTot*Q.term, network=R.networkCost, legacy=R.legacyCost;
  const uses=[["Meters installed (5 years)",capex],["Contingency",cont],["Programme running costs (placeholder; B2C is the next exercise)",runc],["Upkeep gap over meter life",upkeepGap],["Network upgrades (red feeders)",network],["Legacy meter replacement",legacy]];
  const sources=[["Commercial debt, sized at "+Q.dscr+"× cover",E.commercialTot],["Public capital grants / first loss",E.publicTot+cont+runc],["Operating subsidy (upkeep gap)",upkeepGap],["DisCo or DFI network capital",network+legacy]];
  const total=uses.reduce((a,x)=>a+x[1],0), d=Q.discount/100; let pvC=0,pvB=0,peak=0;
